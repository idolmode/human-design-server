# Значения берутся в панели Рег.ру (раздел S3). Ключи никому не отправляйте.
S3_ENDPOINT=https://ВАШ-ENDPOINT-ИЗ-ПАНЕЛИ
S3_REGION=ВАШ-РЕГИОН-ИЗ-ПАНЕЛИ
S3_BUCKET=имя-бакета
S3_KEY=ключ-доступа
S3_SECRET=секретный-ключ
# Если бакет открыт на чтение, укажите базовый адрес файлов (ссылки будут постоянными).
# Если не указывать, сервер выдаёт временные ссылки на 7 дней.
# S3_PUBLIC_BASE=https://АДРЕС-БАКЕТА
# Если сервис требует адресацию без path-style, поставьте false.
# S3_FORCE_PATH_STYLE=true
